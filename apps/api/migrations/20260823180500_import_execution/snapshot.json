    {
      "value": "\"route_version\" = 1",
      "name": "import_evidence_routes_version_check",
      "entityType": "checks",
      "table": "import_evidence_routes"
    },
    {
      "value": "typeof(\"acquisition_generation\") = 'integer' AND \"acquisition_generation\" >= 0 AND \"acquisition_generation\" <= 9007199254740991",
      "name": "import_execution_runs_acquisition_generation_check",
      "entityType": "checks",
      "table": "import_execution_runs"
    },
    {
      "value": "(\n        \"status\" = 'queued'\n        AND \"status_code\" IS NULL\n        AND \"recovery_action\" IS NULL\n      ) OR (\n        \"status\" = 'acquiring'\n        AND \"status_code\" IS NULL\n        AND \"recovery_action\" IS NULL\n      ) OR (\n        \"status\" = 'failed'\n        AND \"status_code\" = 'private_or_unavailable'\n        AND \"recovery_action\" = 'check_source_visibility'\n      ) OR (\n        \"status\" = 'failed'\n        AND \"status_code\" = 'acquisition_temporarily_unavailable'\n        AND \"recovery_action\" = 'retry_later'\n      ) OR (\n        \"status\" = 'failed'\n        AND \"status_code\" = 'invalid_or_unsupported_media'\n        AND \"recovery_action\" = 'submit_supported_public_video'\n      ) OR (\n        \"status\" = 'unsupported'\n        AND \"status_code\" = 'unsupported_post_type'\n        AND \"recovery_action\" = 'submit_supported_public_video'\n      )",
      "name": "import_execution_runs_status_details_check",
      "entityType": "checks",
      "table": "import_execution_runs"
    },
    {
      "value": "\"accounting_scope\" = 'recipe-import'",
      "name": "provider_accounting_budgets_scope_check",
      "entityType": "checks",
      "table": "provider_accounting_budgets"
    },
    {
      "value": "typeof(\"budget_cap_micro_usd\") = 'integer' AND \"budget_cap_micro_usd\" = 10000000",
      "name": "provider_accounting_budgets_cap_check",
      "entityType": "checks",
      "table": "provider_accounting_budgets"
    },
    {
      "value": "typeof(\"settled_micro_usd\") = 'integer' AND \"settled_micro_usd\" >= 0 AND typeof(\"reserved_micro_usd\") = 'integer' AND \"reserved_micro_usd\" >= 0 AND \"settled_micro_usd\" + \"reserved_micro_usd\" <= \"budget_cap_micro_usd\"",
      "name": "provider_accounting_budgets_amounts_check",
      "entityType": "checks",
      "table": "provider_accounting_budgets"
    },
    {
      "value": "(\"state\" = 'open' AND \"invoking_dispatch_id\" IS NULL AND \"poison_dispatch_id\" IS NULL) OR (\"state\" = 'invoking' AND \"invoking_dispatch_id\" IS NOT NULL AND \"poison_dispatch_id\" IS NULL) OR (\"state\" = 'poisoned' AND \"invoking_dispatch_id\" IS NULL AND \"poison_dispatch_id\" IS NOT NULL)",
      "name": "provider_accounting_budgets_state_check",
      "entityType": "checks",
      "table": "provider_accounting_budgets"
    },
    {
      "value": "\"accounting_scope\" = 'recipe-import'",
      "name": "provider_accounting_conservative_settlements_scope_check",
      "entityType": "checks",
      "table": "provider_accounting_conservative_settlements"
    },
    {
      "value": "\"conservative_charge_micro_usd\" = 100000",
      "name": "provider_accounting_conservative_settlements_charge_check",
      "entityType": "checks",
      "table": "provider_accounting_conservative_settlements"
    },
    {
      "value": "\"actual_cost_was_unknown\" = 1",
      "name": "provider_accounting_conservative_settlements_unknown_check",
      "entityType": "checks",
      "table": "provider_accounting_conservative_settlements"
    },
    {
      "value": "\"authority\" = 'schema_valid_provider_response'",
      "name": "provider_accounting_conservative_settlements_authority_check",
      "entityType": "checks",
      "table": "provider_accounting_conservative_settlements"
    },
    {
      "value": "\"accounting_scope\" = 'recipe-import'",
