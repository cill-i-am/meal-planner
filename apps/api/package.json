{
  "name": "@meal-planner/api",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts --name auth_control_plane",
    "auth:schema:generate": "auth generate --config ./auth.config.ts --output ./src/features/auth/auth.database-schema.ts --yes",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --name provider_accounting",
    "household:db:generate": "drizzle-kit generate --config household.drizzle.config.ts --name household_domain",
    "dev": "tsx watch src/main.ts",
    "private-output:db:generate": "drizzle-kit generate --config private-output.drizzle.config.ts --name private_output_lifecycle",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.80",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@effect/platform-node": "4.0.0",
    "@meal-planner/agent-conversations-api": "workspace:*",
    "@meal-planner/browser-observability-api": "workspace:*",
    "@meal-planner/families": "workspace:*",
    "@meal-planner/household-api": "workspace:*",
    "@meal-planner/invitations": "workspace:*",
    "@meal-planner/private-interview-api": "workspace:*",
    "@meal-planner/recipe-domain": "workspace:*",
    "@meal-planner/recipe-import-api": "workspace:*",
    "@tanstack/ai": "0.54.0",
    "@tanstack/ai-cloudflare": "0.1.1",
    "@tanstack/ai-persistence": "0.5.7",
    "@tanstack/openai-base": "0.10.11",
    "agents": "0.22.0",
    "alchemy": "2.0.0-beta.80",
    "better-auth": "1.7.5",
    "cloudflare-drizzle-tracing": "1.1.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "graphql": "17.0.2",
    "jpeg-js": "0.4.4",
    "openai": "6.49.0",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@effect/vitest": "4.0.0",
    "@meal-planner/worker-tests": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.5",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "miniflare": "5.20261001.0-alpha",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
