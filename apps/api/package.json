{
  "name": "@meal-planner/api",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts --name auth_control_plane",
    "auth:schema:generate": "auth generate --config ./auth.config.ts --output ./src/features/auth/auth.database-schema.ts --yes",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --name provider_accounting",
    "household:db:generate": "drizzle-kit generate --config household.drizzle.config.ts --name household_domain",
    "dev": "tsx watch src/main.ts",
    "private-output:db:generate": "drizzle-kit generate --config private-output.drizzle.config.ts --name private_output_lifecycle",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.83",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@effect/platform-node": "4.0.5",
    "@meal-planner/agent-conversations-api": "workspace:*",
    "@meal-planner/browser-observability-api": "workspace:*",
    "@meal-planner/families": "workspace:*",
    "@meal-planner/household-api": "workspace:*",
    "@meal-planner/invitations": "workspace:*",
    "@meal-planner/private-interview-api": "workspace:*",
    "@meal-planner/recipe-domain": "workspace:*",
    "@meal-planner/recipe-import-api": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/ai": "0.69.0",
    "@tanstack/ai-cloudflare": "0.3.0",
    "@tanstack/ai-persistence": "0.9.0",
    "@tanstack/openai-base": "0.14.0",
    "agents": "0.28.1",
    "alchemy": "2.0.0-beta.83",
    "better-auth": "1.7.10",
    "better-call": "1.4.2",
    "cloudflare-drizzle-tracing": "1.2.0",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.5",
    "graphql": "17.0.2",
    "openai": "7.36.0",
    "parse5": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@effect/vitest": "4.0.5",
    "@meal-planner/worker-tests": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.10",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "miniflare": "5.20261012.1-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
