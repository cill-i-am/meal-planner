{
  "name": "@meal-planner/api",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts --name auth_control_plane",
    "auth:schema:generate": "auth generate --config ./auth.config.ts --output ./src/features/auth/auth.database-schema.ts --yes",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --name provider_accounting",
    "household:db:generate": "drizzle-kit generate --config household.drizzle.config.ts --name household_domain",
    "dev": "tsx watch src/main.ts",
    "private-output:db:generate": "drizzle-kit generate --config private-output.drizzle.config.ts --name private_output_lifecycle",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.87",
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/drizzle": "2.0.0-beta.87",
    "@better-auth/drizzle-adapter": "1.7.25",
    "@better-auth/oauth-provider": "1.7.25",
    "@effect/platform-node": "4.1.4",
    "@meal-planner/agent-conversations-api": "workspace:*",
    "@meal-planner/families": "workspace:*",
    "@meal-planner/household-api": "workspace:*",
    "@meal-planner/invitations": "workspace:*",
    "@meal-planner/private-interview-api": "workspace:*",
    "@meal-planner/recipe-domain": "workspace:*",
    "@meal-planner/recipe-import-api": "workspace:*",
    "@modelcontextprotocol/ext-tasks": "0.2.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@tanstack/ai": "1.5.0",
    "@tanstack/ai-cloudflare": "1.2.1",
    "@tanstack/ai-persistence": "1.0.1",
    "@tanstack/openai-base": "1.0.4",
    "agents": "0.33.0",
    "alchemy": "2.0.0-beta.87",
    "better-auth": "1.7.25",
    "better-call": "1.4.5",
    "cloudflare-drizzle-tracing": "1.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "graphql": "17.1.0",
    "openai": "7.58.0",
    "parse5": "8.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.16",
    "set-cookie-parser": "3.2.3"
  },
  "devDependencies": {
    "@alchemy.run/sql": "2.0.0-beta.87",
    "@alchemy.run/test": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20261117.1",
    "@effect/vitest": "4.1.4",
    "@meal-planner/worker-tests": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.25",
    "drizzle-kit": "1.0.0-rc.5",
    "miniflare": "5.20261117.0-beta",
    "msw": "2.15.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
