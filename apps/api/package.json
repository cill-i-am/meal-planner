{
  "name": "@meal-planner/api",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts --name auth_control_plane",
    "auth:schema:generate": "auth generate --config ./auth.config.ts --output ./src/features/auth/auth.database-schema.ts --yes",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --name provider_accounting",
    "household:db:generate": "drizzle-kit generate --config household.drizzle.config.ts --name household_domain",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.0-rc.6",
    "@effect/platform-node": "4.0.0-rc.112",
    "@meal-planner/household-api": "workspace:*",
    "@meal-planner/recipe-import-api": "workspace:*",
    "better-auth": "1.7.0-rc.6",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "graphql": "16.11.0",
    "jpeg-js": "0.4.4",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@distilled.cloud/cloudflare-rolldown-plugin": "0.17.1",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "24.13.2",
    "auth": "1.7.0-rc.6",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "miniflare": "4.20260714.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
