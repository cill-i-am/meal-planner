ke `{ name, message, internalCode }` or\n * `{ errors: [{ code, message }] }`. The OpenAI SDK only reads\n * `body.error.message`, so rewrap them or every failure reads as\n * \"status code (no body)\".\n */\nexport async function normalizeErrorResponse(\n  response: Response,\n): Promise<Response> {\n  const text = await response.text()\n  let body = text\n  try {\n    const json = JSON.parse(text) as {\n      error?: unknown\n      errors?: Array<{ code?: number; message?: string }>\n      message?: string\n      name?: string\n      internalCode?: number\n    }\n    if (json && typeof json === 'object' && !('error' in json)) {\n      const first = json.errors?.[0]\n      body = JSON.stringify({\n        error: {\n          message: json.message ?? first?.message ?? text,\n          type: json.name ?? 'cloudflare_error',\n          code: json.internalCode ?? first?.code ?? null,\n        },\n      })\n    }\n  } catch {\n    // Not JSON: forward the text as-is.\n  }\n  return new Response(body, {\n    status: response.status,\n    statusText: response.statusText,\n    headers: response.headers,\n  })\n}\n\n/** Applies the error and SSE normalizations a raw Cloudflare response needs. */\nexport async function normalizeResponse(response: Response): Promise<Response> {\n  return response.ok\n    ? normalizeSseResponse(response)\n    : await normalizeErrorResponse(response)\n}\n\n/**\n * Makes `env.AI` look like an OpenAI-compatible HTTP endpoint to the OpenAI\n * SDK: the JSON request body becomes `binding.run(model, inputs)` and the\n * raw inference `Response` (OpenAI-format JSON or SSE) is handed back.\n */\nexport function createBindingFetch(\n  binding: Ai,\n  gateway?: CloudflareGatewayOptions,\n): FetchLike {\n  // `Ai` is typed against the bundled model catalog; the adapter accepts any\n  // model id, so widen the binding to the open catalog shape for this call.\n  const run = binding.run.bind(binding) as (\n    model: string,\n    inputs: Record<string, unknown>,\n    options: Record<string, unknown>,\n  ) => Promise<unknown>\n  return async (_input, init) => {\n    const { model, ...inputs } = JSON.parse(\n      typeof init?.body === 'string' ? init.body : '{}',\n    ) as { model: string } & Record<string, unknown>\n    const response = (await run(model, inputs, {\n      returnRawResponse: true,\n      ...(gateway && { gateway }),\n    })) as Response\n    return await normalizeResponse(response)\n  }\n}\n\n/** Wraps a REST fetch so responses get the same error and trailer fixes. */\nexport function createRestFetch(baseFetch: FetchLike | undefined): FetchLike {\n  const fetchImpl = baseFetch ?? fetch\n  return async (input, init) =>\n    await normalizeResponse(await fetchImpl(input, init))\n}\n"],"mappings":";;;;;;;;AAUA,SAAgB,qBAAqB,UAA8B;CACjE,MAAM,cAAc,SAAS,QAAQ,IAAI,cAAc,KAAK;CAC5D,IAAI,CAAC,SAAS,QAAQ,CAAC,YAAY,SAAS,mBAAmB,GAC7D,OAAO;CAET,IAAI,SAAS;CACb,MAAM,WAAW,SAAyB;EACxC,IAAI,CAAC,KAAK,WAAW,QAAQ,KAAK,SAAS,gBAAgB,OAAO;EAClE,IAAI;GACF,MAAM,QAAQ,KAAK,MAAM,KAAK,MAAM,CAAC,CAAC;GACtC,IAAI,SAAS,OAAO,UAAU,YAAY,EAAE,aAAa,QACvD,OAAO,SAAS,KAAK,UAAU;IAAE,GAAG;IAAO,SAAS,CAAC;GAAE,CAAC;EAE5D,QAAQ,CAER;EACA,OAAO;CACT;CACA,MAAM,OAAO,SAAS,KACnB,YAAY,IAAI,kBAAkB,CAAC,CAAC,CACpC,YACC,IAAI,gBAAgC;EAClC,UAAU,OAAO,YAAY;GAC3B,UAAU;GACV,MAAM,QAAQ,OAAO,MAAM,IAAI;GAC/B,SAAS,MAAM,IAAI,KAAK;GACxB,KAAK,MAAM,QAAQ,OAAO,WAAW,QAAQ,GAAG,QAAQ,IAAI,EAAE,GAAG;EACnE;EACA,MAAM,YAAY;GAChB,IAAI,QAAQ,WAAW,QAAQ,QAAQ,MAAM,CAAC;EAChD;CACF,CAAC,CACH,CAAC,CACA,YAAY,IAAI,kBAAkB,CAAC;CACtC,OAAO,IAAI,SAAS,MAAM;EACxB,QAAQ,SAAS;EACjB,YAAY,SAAS;EACrB,SAAS,SAAS;CACpB,CAAC;AACH;;;;;;;AAQA,eAAsB,uBACpB,UACmB;CACnB,MAAM,OAAO,MAAM,SAAS,KAAK;CACjC,IAAI,OAAO;CACX,IAAI;EACF,MAAM,OAAO,KAAK,MAAM,IAAI;EAO5B,IAAI,QAAQ,OAAO,SAAS,YAAY,EAAE,WAAW,OAAO;GAC1D,MAAM,QAAQ,KAAK,SAAS;GAC5B,OAAO,KAAK,UAAU,EACpB,OAAO;IACL,SAAS,KAAK,WAAW,OAAO,WAAW;IAC3C,MAAM,KAAK,QAAQ;IACnB,MAAM,KAAK,gBAAgB,OAAO,QAAQ;GAC5C,EACF,CAAC;EACH;CACF,QAAQ,CAER;CACA,OAAO,IAAI,SAAS,MAAM;EACxB,QAAQ,SAAS;EACjB,YAAY