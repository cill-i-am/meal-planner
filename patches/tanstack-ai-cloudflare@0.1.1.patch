  const run = binding.run.bind(binding) as (\n    model: string,\n    inputs: Record<string, unknown>,\n    options: Record<string, unknown>,\n  ) => Promise<unknown>\n  return async (_input, init) => {\n    const { model, ...inputs } = JSON.parse(\n      typeof init?.body === 'string' ? init.body : '{}',\n    ) as { model: string } & Record<string, unknown>\n    const response = (await run(model, inputs, {\n      returnRawResponse: true,\n      signal: init?.signal,\n      ...(gateway && { gateway }),\n      ...(extraHeaders?.['cf-aig-max-attempts'] !== undefined && {\n        extraHeaders: { 'cf-aig-max-attempts': extraHeaders['cf-aig-max-attempts'] },\n      }),\n    })) as Response\n    return await normalizeResponse(response)\n  }\n}\n\n/** Wraps a REST fetch so responses get the same error and trailer fixes. */\nexport function createRestFetch(baseFetch: FetchLike | undefined): FetchLike {\n  const fetchImpl = baseFetch ?? fetch\n  return async (input, init) =>\n    await normalizeResponse(await fetchImpl(input, init))\n}\n"],"mappings":";;;;;;;;AAUA,SAAgB,qBAAqB,UAA8B;CACjE,MAAM,cAAc,SAAS,QAAQ,IAAI,cAAc,KAAK;CAC5D,IAAI,CAAC,SAAS,QAAQ,CAAC,YAAY,SAAS,mBAAmB,GAC7D,OAAO;CAET,IAAI,SAAS;CACb,MAAM,WAAW,SAAyB;EACxC,IAAI,CAAC,KAAK,WAAW,QAAQ,KAAK,SAAS,gBAAgB,OAAO;EAClE,IAAI;GACF,MAAM,QAAQ,KAAK,MAAM,KAAK,MAAM,CAAC,CAAC;GACtC,IAAI,SAAS,OAAO,UAAU,YAAY,EAAE,aAAa,QACvD,OAAO,SAAS,KAAK,UAAU;IAAE,GAAG;IAAO,SAAS,CAAC;GAAE,CAAC;EAE5D,QAAQ,CAER;EACA,OAAO;CACT;CACA,MAAM,OAAO,SAAS,KACnB,YAAY,IAAI,kBAAkB,CAAC,CAAC,CACpC,YACC,IAAI,gBAAgC;EAClC,UAAU,OAAO,YAAY;GAC3B,UAAU;GACV,MAAM,QAAQ,OAAO,MAAM,IAAI;GAC/B,SAAS,MAAM,IAAI,KAAK;GACxB,KAAK,MAAM,QAAQ,OAAO,WAAW,QAAQ,GAAG,QAAQ,IAAI,EAAE,GAAG;EACnE;EACA,MAAM,YAAY;GAChB,IAAI,QAAQ,WAAW,QAAQ,QAAQ,MAAM,CAAC;EAChD;CACF,CAAC,CACH,CAAC,CACA,YAAY,IAAI,kBAAkB,CAAC;CACtC,OAAO,IAAI,SAAS,MAAM;EACxB,QAAQ,SAAS;EACjB,YAAY,SAAS;EACrB,SAAS,SAAS;CACpB,CAAC;AACH;;;;;;;AAQA,eAAsB,uBACpB,UACmB;CACnB,MAAM,OAAO,MAAM,SAAS,KAAK;CACjC,IAAI,OAAO;CACX,IAAI;EACF,MAAM,OAA