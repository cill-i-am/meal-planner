# Authenticates system-only batch and provider-settlement routes. Household web
# profiles must never use this token. Use a long random value; never commit it.
MEAL_PLANNER_IMPORT_API_TOKEN=replace-with-random-system-import-token
# Opaque SHA-256 identities for the designated system principal.
MEAL_PLANNER_IMPORT_ACTOR_ID=replace-with-64-character-lowercase-hex-actor-id
MEAL_PLANNER_IMPORT_HOUSEHOLD_SCOPE_ID=replace-with-64-character-lowercase-hex-household-id

# Better Auth signs same-origin session cookies with this server-only secret.
# Those sessions authorize household routes such as /v1/recipe-import-intents.
# Use at least 32 random bytes; never expose it through a VITE_ variable.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes

# Optional native Alchemy development: reuse an existing Cloudflare AI gateway.
# Keep the token server-only; no remote gateway/token is created during dev.
# LOCAL_AGENT_ACCOUNT_ID=
# LOCAL_AGENT_GATEWAY_ID=
# LOCAL_AGENT_API_TOKEN=
# LOCAL_AGENT_CONVERSATION_CONFIG={"gatewayId":"existing-gateway","maxOutputTokens":8192,"model":"openai/gpt-6-luna","provider":"cloudflare-responses","timeoutMs":120000}
# LOCAL_AGENT_PRIVATE_DISCOVERY_CONFIG={"gatewayId":"existing-gateway","inputUsdPerMillionTokens":0.1,"maxOutputTokens":8192,"model":"openai/gpt-6-luna","outputUsdPerMillionTokens":0.5,"provider":"cloudflare-responses","timeoutMs":120000}
