# Server
PORT=3000
HOST=127.0.0.1

# Authenticates system-only batch and provider-settlement routes. Household web
# profiles must never use this token. Use a long random value; never commit it.
MEAL_PLANNER_IMPORT_API_TOKEN=replace-with-random-system-import-token
# Closed server-only registry for household-scoped /v1/recipe-import-intents,
# action, and /v1/recipes routes.
MEAL_PLANNER_IMPORT_CONFIGURED_PRINCIPALS_JSON='[{"token":"replace-with-random-household-a-token","actorId":"replace-with-64-character-lowercase-hex-actor-a","householdScopeId":"replace-with-64-character-lowercase-hex-household-a"},{"token":"replace-with-random-household-b-token","actorId":"replace-with-64-character-lowercase-hex-actor-b","householdScopeId":"replace-with-64-character-lowercase-hex-household-b"}]'
# Opaque SHA-256 identities for the designated system principal.
MEAL_PLANNER_IMPORT_ACTOR_ID=replace-with-64-character-lowercase-hex-actor-id
MEAL_PLANNER_IMPORT_HOUSEHOLD_SCOPE_ID=replace-with-64-character-lowercase-hex-household-id

# TanStack Start server-only household profile registry. These names deliberately
# have no VITE_ prefix: tokens must never be bundled into browser code.
RECIPE_IMPORT_API_BASE_URL=http://127.0.0.1:3000
RECIPE_IMPORT_DEFAULT_PROFILE_ALIAS=household-a
RECIPE_IMPORT_PROFILE_A_ALIAS=household-a
RECIPE_IMPORT_PROFILE_A_LABEL=Household A
RECIPE_IMPORT_PROFILE_A_TOKEN=replace-with-random-household-a-token
RECIPE_IMPORT_PROFILE_B_ALIAS=household-b
RECIPE_IMPORT_PROFILE_B_LABEL=Household B
RECIPE_IMPORT_PROFILE_B_TOKEN=replace-with-random-household-b-token

# Tesco XAPI configuration
TESCO_MANGO_URL=https://xapi.tesco.com/
TESCO_SUGGESTION_URL=https://search.api.tesco.com/search/suggestion/
TESCO_LOCALE=en-IE
TESCO_REGION=IE

# Fill these from a currently logged-in Tesco browser session.
# Do not commit real values.
TESCO_MANGO_API_KEY=replace-with-current-api-key
TESCO_AUTHORIZATION=Bearer replace-with-current-token
TESCO_AUTH_COOKIE_HEADER="OAuth.TokensExpiryTime=replace-with-encoded-expiry-json; replace-with-other-auth-cookies"
TESCO_SOFT_REFRESH_SIGN_IN_URL=https://www.tesco.ie/account/login/en-IE
TESCO_AUTH_REFRESH_FROM_URL=https://www.tesco.ie/shop/en-IE

# Optional Tesco headers. Leave unset unless the browser request includes them.
# TESCO_TRANSACTION_PURPOSE=
# TESCO_RELEASE_BRANCH=
