{
  "name": "meal-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "alchemy:deploy": "alchemy deploy",
    "alchemy:destroy": "alchemy destroy",
    "alchemy:plan": "alchemy plan",
    "auth:db:generate": "pnpm --filter @meal-planner/api auth:db:generate",
    "auth:schema:generate": "pnpm --filter @meal-planner/api auth:schema:generate",
    "build": "pnpm --recursive build",
    "check": "pnpm evals:check && tsc -p tsconfig.alchemy.json --noEmit && pnpm --recursive check",
    "db:generate": "pnpm --filter @meal-planner/api db:generate",
    "dev": "alchemy dev --env-file .dev.vars",
    "dev:tesco": "pnpm --filter @meal-planner/api dev",
    "docs:check": "python3 scripts/check-docs.py",
    "docs:test": "python3 -m unittest discover -s scripts/tests -p 'test_docs_check.py'",
    "evals:check": "node --import tsx evals/private-discovery/validate.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm lint:oxlint && pnpm lint:complexity",
    "lint:complexity": "cccc --config cccc.toml --table --min 20 .",
    "lint:fix": "oxlint --fix --deny-warnings --report-unused-disable-directives . && pnpm lint:complexity",
    "lint:oxlint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "vitest run --config vitest.alchemy.config.ts && pnpm --recursive test",
    "test:stack": "vitest run --config vitest.stack.config.ts",
    "test:container": "MEAL_PLANNER_RUN_CONTAINER_TESTS=1 pnpm --filter @meal-planner/api exec vitest run --config vitest.container.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@effect/platform-node": "4.0.5",
    "@effect/sql-d1": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@oxlint/plugins": "1.88.0",
    "@shadcn/lint": "0.2.1",
    "@types/node": "26.6.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "miniflare": "5.20261012.1-beta",
    "mysql2": "3.24.6",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ultracite": "8.0.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
